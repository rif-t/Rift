using std

/*

FUNCTIONS
Author: rif-t 25.10.2026 21:11 GMT+2:00

*/

namespace some_math { // Using with namespace

    func double(value: int) -> int { // Function that doubles input value

        return value * 2 // returning result

    }

}

func even(a : int) -> bool { // Function that check is number even

    return (a%2==0 ? true : false)

}

func main(){ // Using functions

    println(some_math.double(2)) // Doubling 2


    println(even(1), ' ', even(2)) // Checking


    n : int = some_math.double(100) // Assigning
    println(n) //Printing n

}
